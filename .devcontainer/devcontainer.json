{
  "name": "Azure MCP Copilot Workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "customizations": {
    "vscode": {
      "extensions": ["GitHub.copilot", "GitHub.copilot-chat"],
      "settings": {
        "mcp.servers": {
          "azure": {
            "command": "npx",
            "args": ["-y", "@azure/mcp@latest", "server", "start"]
          }
        }
      }
    }
  }
}
